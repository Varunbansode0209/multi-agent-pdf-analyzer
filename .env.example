
# OpenAI / LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna

# Embeddings
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
MIN_SIMILARITY=0.25
MAX_CONTEXT_CHARS=6000
MAX_HISTORY_TURNS=3

# Summarization
MAP_BATCH_CHARS=12000
MAP_CONCURRENCY=5
REDUCE_MAX_CHARS=16000

# Vector database
COLLECTION_NAME=pdf_chunks
CHROMA_PERSIST_DIR=./data/vectorstore

# Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=200

# API
API_URL=http://localhost:8000

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO

# LLM configuration
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
